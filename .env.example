# ===== 通知渠道配置模板 =====
# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 排除，不会提交到仓库）
# 留空 = 自动降级为控制台模式（本地开发安全模式）

# 钉钉群机器人 Webhook 地址（自定义机器人，安全设置建议用"自定义关键词：告警"）
# 主机监控与校园数字孪生模块共用此渠道；校园消息标题带「[校园]」便于过滤
DINGTALK_WEBHOOK=

# 校园告警是否推送通知（1=开，0=关；关掉后仍入库/进面板，只是不推钉钉）
# 生成器高频故障注入压测时建议设 0，避免刷屏
CAMPUS_NOTIFY=1

# SMTP 邮件（QQ邮箱授权码，非登录密码）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# Web 服务（可选，默认 0.0.0.0:5000）
WEB_HOST=0.0.0.0
WEB_PORT=5000
