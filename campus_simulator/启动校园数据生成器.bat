@echo off
cd /d "%~dp0"
title campus_sim 校园数据生成器
echo ============================================================
echo   校园模拟数据生成器（独立模块 / 传感器模拟器）
echo   向 http://127.0.0.1:5000 上报 10 栋楼数据
echo   启动前请先运行 上级目录的 启动监控-免Docker.bat
echo ------------------------------------------------------------
echo   常用参数（可叠加，写在后面即可）:
echo     --interval 1     上报周期秒（默认演示用 1）
echo     --speed 120      虚拟时钟 120 倍速，快速看全天曲线
echo     --fault-prob 0.2 提高故障概率，多看告警
echo     Ctrl+C 停止
echo ============================================================
echo.
py "%~dp0campus_sim.py" --interval 1 %*
echo.
echo ** 生成器已退出，若上方有报错请截图发给我 **
pause
